rules_version = '2';
service firebase.storage {
 match /b/{bucket}/o {
  function signedIn() { return request.auth != null; }
  match /profiles/{userId}/{allPaths=**} { allow read: if signedIn(); allow write: if signedIn() && request.auth.uid == userId && request.resource.size < 5 * 1024 * 1024; }
  match /conversations/{conversationId}/{allPaths=**} { allow read, write: if signedIn() && request.resource.size < 25 * 1024 * 1024; }
  match /advisor-documents/{userId}/{allPaths=**} { allow read: if signedIn() && request.auth.uid == userId; allow write: if signedIn() && request.auth.uid == userId && request.resource.size < 10 * 1024 * 1024; }
 }
}
