rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function user() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function isAdmin() { return signedIn() && user().data.role == 'admin'; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function participant(conversationId) { return signedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds; }
    function related(data) { return signedIn() && (request.auth.uid == data.studentId || request.auth.uid == data.advisorId); }

    match /users/{uid} { allow read: if isOwner(uid) || isAdmin(); allow create: if isOwner(uid) && request.resource.data.role in ['student','advisor']; allow update: if (isOwner(uid) && request.resource.data.role == resource.data.role) || isAdmin(); allow delete: if isAdmin(); }
    match /students/{uid} { allow read, write: if isOwner(uid) || isAdmin(); }
    match /advisors/{uid} { allow read: if signedIn(); allow create: if isOwner(uid); allow update: if isAdmin() || (isOwner(uid) && request.resource.data.approvalStatus == resource.data.approvalStatus); }
    match /{collection}/{id} { allow read: if signedIn() && collection in ['majors','major_categories','skills','skill_categories','interests','interest_categories','assessments']; allow write: if isAdmin(); }
    match /assessments/{assessmentId}/questions/{questionId} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /assessment_results/{id} { allow read: if isOwner(resource.data.studentId) || isAdmin(); allow create: if isOwner(request.resource.data.studentId); allow update,delete: if isAdmin(); }
    match /recommendations/{id} { allow read: if isOwner(resource.data.studentId) || isAdmin(); allow create,update,delete: if isAdmin(); }
    match /consultations/{id} { allow read: if related(resource.data) || isAdmin(); allow create: if isOwner(request.resource.data.studentId); allow update: if related(resource.data) || isAdmin(); }
    match /appointments/{id} { allow read: if related(resource.data) || isAdmin(); allow create: if isOwner(request.resource.data.studentId); allow update: if related(resource.data) || isAdmin(); }
    match /availability/{id} { allow read: if signedIn(); allow create,update,delete: if isOwner(request.resource.data.advisorId) || isAdmin(); }
    match /notifications/{id} { allow read,update: if isOwner(resource.data.recipientId) || isAdmin(); allow create: if isAdmin(); }
    match /conversations/{id} { allow read,update: if participant(id); allow create: if signedIn() && request.auth.uid in request.resource.data.participantIds; match /messages/{messageId} { allow read: if participant(id); allow create: if participant(id) && request.auth.uid == request.resource.data.senderId; allow update: if participant(id); match /reactions/{reactionId} { allow read: if participant(id); allow create,delete: if participant(id) && request.auth.uid == reactionId; } } }
    match /calls/{id} { allow read,update: if request.auth.uid == resource.data.callerId || request.auth.uid == resource.data.recipientId || isAdmin(); allow create: if isOwner(request.resource.data.callerId); }
  }
}
