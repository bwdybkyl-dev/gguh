rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(id) { return signedIn() && request.auth.uid == id; }
    function admin() { return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'; }
    match /users/{userId} { allow read: if owner(userId) || admin(); allow create: if owner(userId); allow update: if owner(userId) || admin(); allow delete: if admin(); }
    match /students/{userId} { allow read, write: if owner(userId) || admin(); }
    match /advisors/{userId} { allow read: if signedIn(); allow create, update: if owner(userId) || admin(); }
    match /{collection}/{id} { allow read: if signedIn() && collection in ['majors','skills','assessments','major_categories','skill_categories']; allow write: if admin(); }
    match /conversations/{id} { allow read, update: if signedIn() && request.auth.uid in resource.data.participantIds; allow create: if signedIn() && request.auth.uid in request.resource.data.participantIds; match /messages/{messageId} { allow read: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(id)).data.participantIds; allow create: if signedIn() && request.auth.uid == request.resource.data.senderId; allow update: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(id)).data.participantIds; } }
  }
}
